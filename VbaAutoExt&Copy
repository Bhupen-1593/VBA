in_date = Application.WorksheetFunction. _
VLookup("AK070", Worksheets("LatestDate").Range("C3", Worksheets("LatestDate").Range("D3").End(xlDown)), 2)
ch.FindElementById(":rc:").SendKeys DateAdd("d", 1, in_date)
ch.FindElementById(":rd:").SendKeys VBA.Format(Date - 1, "dd/mm/yyyy")
ch.FindElementByXPath("//button[@tabindex='-1']").Click
ch.FindElementByXPath("//button[@type='submit']").Click
ch.FindElementByXPath("//button[text()='Download Excel']").Click
End Sub                                                                 'this sub routine uses selenium libarary to interact with the CRMS site and extract data
