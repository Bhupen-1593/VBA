Private Sub testselenium()
Dim rng As Range
Dim cr_rng As Range
Dim in_date As Date
Set ch = New Selenium.ChromeDriver
Dim Customer As Object
Dim Site As Object
Dim loc As Object
ch.SetPreference "download.default_directory", Worksheets("Custom").Range("B3").Value
ch.Start baseUrl:="https://crms.suzlon.com"
ch.Get "/"
Application.Wait (Now + TimeValue("00:00:05"))
ch.FindElementById(":r0:").SendKeys "geecvent"
ch.FindElementById(":r1:").SendKeys "Geecee@100"
